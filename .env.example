# Copy this file to `.env` and fill in your Kite Connect app credentials.
#
# Get them from the Kite Connect developer console:
#   https://developers.kite.trade
#
# The same values are documented in the Kite Connect HTTP API user guide:
#   https://kite.trade/docs/connect/v3/user/#login-flow
#
# `.env` is gitignored. Never commit a populated copy of this file.

# Required: Kite Connect credentials.
KITE_API_KEY=
KITE_API_SECRET=

# Optional: local callback URL for CLI auto request_token capture.
# Default: http://127.0.0.1:5000/callback
KITE_REDIRECT_URL=http://127.0.0.1:5000/callback

# Optional: dashboard title.
# Default: Raghava's Portfolio
KITE_DASHBOARD_NAME=Raghava's Portfolio

# Optional: comma-separated header index tickers (NSE). Shorthand:
# NIFTY50, BANKNIFTY, NIFTYIT, NIFTYFINSERVICE, NIFTYMET.
# You can also pass full Kite index tradingsymbols (e.g. NIFTY MIDCAP 100).
# Default: NIFTY50,BANKNIFTY,NIFTYIT,NIFTYFINSERVICE,NIFTYMET
KITE_DASHBOARD_INDICES=NIFTY50,BANKNIFTY,NIFTYIT,NIFTYFINSERVICE,NIFTYMET

# Optional: full dashboard REST snapshot interval in seconds.
# Minimum: 10
# Default: 120
DASHBOARD_SNAPSHOT_SECONDS=120

# Optional legacy alias used only when DASHBOARD_SNAPSHOT_SECONDS is unset.
# Default: 120
DASHBOARD_REFRESH_SECONDS=120

# Optional: worker count for MF underlying fetch parallelism (mfdata.in).
# Range effectively clamped in code to 1..16.
# Default: 6
MFDATA_MAX_FETCH_WORKERS=6

# Optional: shared TTL (seconds) for reference_data cache entries:
# cash-equity lookups, NSE merged industry maps, and Nifty 50 symbols.
# Default: 86400 (1 day)
REFERENCE_CACHE_TTL_SECONDS=86400

# Optional: set to 1/true/yes for verbose WebSocket/tick logs.
# Default: disabled
# DASHBOARD_DEBUG_WS=1

# Optional: MarketSmith India market-regime snapshot (dashboard banner; see README).
# Regime data is fetched at most once per local calendar day (memory + disk cache).
# Override the gateway ``ms-auth`` query when unset (public web guest placeholder).
# MARKETSMITH_MS_AUTH=

# Optional: stable secret for signing the web dashboard session cookie.
# If unset, the app uses OS keychain (keyring) or falls back to a per-run secret.
# SESSION_SECRET=replace_with_long_random_secret
