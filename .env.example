# Copy this file to `.env` and fill in your Kite Connect app credentials.
#
# Get them from the Kite Connect developer console:
#   https://developers.kite.trade
#
# The same values are documented in the Kite Connect HTTP API user guide:
#   https://kite.trade/docs/connect/v3/user/#login-flow
#
# `.env` is gitignored. Never commit a populated copy of this file.
#
# Optional: stable secret for signing the web dashboard session cookie (same
# value across restarts). If unset, the app uses the OS keychain (keyring) or
# falls back to a per-run secret (see app.web._session_secret).
# SESSION_SECRET=

KITE_API_KEY=
KITE_API_SECRET=
KITE_DASHBOARD_NAME=Raghava`s Porfolio
# Comma-separated header index tickers (NSE). Shorthand: NIFTY50, BANKNIFTY, NIFTYIT, NIFTYFINSERVICE, NIFTYMET.
# You can also pass full Kite index tradingsymbols (e.g. NIFTY MIDCAP 100).
# Default if unset: NIFTY50,BANKNIFTY,NIFTYIT,NIFTYFINSERVICE,NIFTYMET
# KITE_DASHBOARD_INDICES=NIFTY50,BANKNIFTY,NIFTYIT,NIFTYFINSERVICE,NIFTYMET
# Full dashboard REST snapshot interval (minimum 10 seconds). Mutual funds,
# cash/margins, and row structure refresh here; live LTP/P&L updates use
# WS /ws/live-prices instead of hammering GET /dashboard (live P&L).
DASHBOARD_SNAPSHOT_SECONDS=120
# Legacy alias: if DASHBOARD_SNAPSHOT_SECONDS is unset, this value is used.
# DASHBOARD_REFRESH_SECONDS=120
# Set to 1/true for verbose WebSocket/tick logs and to show KiteTicker (Zerodha
# wss) ERROR lines from pykiteconnect. When unset, kiteconnect.ticker is quiet.
# DASHBOARD_DEBUG_WS=1
