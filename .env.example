# Copy this file to `.env` and fill in your Kite Connect app credentials.
#
# Get them from the Kite Connect developer console:
#   https://developers.kite.trade
#
# The same values are documented in the Kite Connect HTTP API user guide:
#   https://kite.trade/docs/connect/v3/user/#login-flow
#
# `.env` is gitignored. Never commit a populated copy of this file.

KITE_API_KEY=
KITE_API_SECRET=
